{
  "name": "flowhub-plugins",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir plugins/machines run dev",
    "dev:machines": "pnpm --dir plugins/machines run dev",
    "dev:docker": "pnpm --dir plugins/docker run dev",
    "dev:resource-monitor": "pnpm --dir plugins/resource-monitor run dev",
    "dev:device-center": "pnpm --dir plugins/device-center run dev",
    "build:device-center": "pnpm --dir plugins/device-center run build",
    "test:device-center": "pnpm --dir plugins/device-center test",
    "install:machines": "pnpm --dir plugins/machines install --frozen-lockfile",
    "install:docker": "pnpm --dir plugins/docker install --frozen-lockfile",
    "install:social-hub": "pnpm --dir plugins/social-hub install --frozen-lockfile",
    "install:twofa": "pnpm --dir plugins/twofa install --frozen-lockfile",
    "install:resource-monitor": "pnpm --dir plugins/resource-monitor install --frozen-lockfile",
    "build": "node scripts/run-all.mjs build",
    "check": "node scripts/check-plugins.mjs",
    "test": "node scripts/check-plugins.mjs && pnpm run test:common && node scripts/run-all.mjs test",
    "test:common": "pnpm --dir plugins/common run check && node --test scripts/common-assets.test.mjs scripts/check-built-ui.test.mjs",
    "build:machines": "pnpm --dir plugins/machines run build",
    "build:docker": "pnpm --dir plugins/docker run build",
    "build:social-hub": "pnpm --dir plugins/social-hub run build",
    "build:twofa": "pnpm --dir plugins/twofa run build",
    "build:resource-monitor": "pnpm --dir plugins/resource-monitor run build",
    "test:machines": "pnpm --dir plugins/machines test",
    "layout:machines": "pnpm --dir plugins/machines run layout",
    "test:docker": "pnpm --dir plugins/docker test",
    "test:social-hub": "pnpm --dir plugins/social-hub test",
    "test:twofa": "pnpm --dir plugins/twofa test",
    "test:resource-monitor": "pnpm --dir plugins/resource-monitor test"
  },
  "packageManager": "pnpm@10.15.1"
}
