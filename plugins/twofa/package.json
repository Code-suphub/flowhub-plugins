{
  "name": "flowhub-twofa-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5197",
    "build": "node scripts/build.mjs",
    "build:ui": "vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path backend/Cargo.toml && npm run typecheck && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@flowhub/plugin-common": "file:../common",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
