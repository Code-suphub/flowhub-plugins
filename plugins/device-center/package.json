{
  "name": "flowhub-device-center-plugin",
  "version": "0.3.13",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "cargo test --manifest-path backend/Cargo.toml && pnpm run typecheck && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "build:ui": "vite build --config vite.config.mjs",
    "dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5188"
  },
  "dependencies": {
    "@flowhub/plugin-common": "link:../common",
    "@mdi/js": "7.4.47",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fsevents"
    ]
  }
}
