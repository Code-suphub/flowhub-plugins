{
  "name": "flowhub-resource-monitor-plugin",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5186",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build --config vite.config.mjs",
    "build": "node scripts/build.mjs",
    "test": "cargo test --manifest-path backend/Cargo.toml && pnpm run typecheck && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.0",
    "@flowhub/plugin-common": "link:../common",
    "@local/common-components": "link:../../../common-components",
    "antd": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "pnpm": {"onlyBuiltDependencies": ["esbuild", "fsevents"]}
}
