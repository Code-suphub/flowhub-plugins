{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "module": "ESNext", "moduleResolution": "Bundler", "isolatedModules": true,
    "noEmit": true, "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types"], "types": ["react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../common/src/**/*.ts", "../common/src/**/*.tsx"]
}
