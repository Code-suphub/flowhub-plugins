{
  "name": "flowhub-social-hub-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.mjs --host 127.0.0.1 --port 5198",
    "build": "node scripts/build.mjs",
    "build:ui": "vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path backend/Cargo.toml && pnpm run typecheck && node --test tests/*.test.cjs",
    "plasmic:dev": "vite --config vite.plasmic.config.mjs --mode plasmic-pages --host 127.0.0.1 --port 5206",
    "plasmic:layouts:sync": "node ../../scripts/plasmic/cli.mjs social-hub"
  },
  "dependencies": {
    "@flowhub/plugin-common": "link:../common",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fsevents"
    ]
  }
}
